{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned .NET enum observation fixture",
  "description": "Fixture structure only, not a product enum admission schema. IDs are tuples described in README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "runtime", "enumDefinitions", "count", "cases"],
  "properties": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit", "package"],
      "properties": {
        "repository": {"const": "Cratis/Fundamentals"},
        "commit": {"const": "d2accc4a79b6bcf2708213c97093ab5ba6c06381"},
        "package": {"const": "source extraction, not a published package"}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["framework", "environmentVersion", "architecture", "os", "jsonAssembly", "jsonInformationalVersion", "culture"],
      "properties": {
        "framework": {"const": ".NET 10.0.12"},
        "environmentVersion": {"const": "10.0.12"},
        "architecture": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "jsonAssembly": {"type": "string", "minLength": 1},
        "jsonInformationalVersion": {"const": "10.0.12+95017c711e6afc1085133d440e42b4bd78155701"},
        "culture": {"const": ""}
      }
    },
    "enumDefinitions": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "backing", "flags", "members"],
        "properties": {
          "name": {"$ref": "#/$defs/enumName"},
          "backing": {"enum": ["Int32", "Byte", "UInt32", "Int64"]},
          "flags": {"type": "boolean"},
          "members": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "numeric"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "numeric": {"$ref": "#/$defs/integerString"}
              }
            }
          }
        }
      }
    },
    "count": {"const": 236},
    "cases": {
      "type": "array", "minItems": 236, "maxItems": 236,
      "items": {"oneOf": [{"$ref": "#/$defs/read"}, {"$ref": "#/$defs/write"}, {"$ref": "#/$defs/direct"}]}
    }
  },
  "$defs": {
    "enumName": {"enum": ["Plain", "NoZero", "Bits", "ByteEnum", "UIntEnum", "LongEnum"]},
    "integerString": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$"},
    "numeric": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/integerString"}]},
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "message", "innerType", "innerMessage"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "innerType": {"type": ["string", "null"]},
        "innerMessage": {"type": ["string", "null"]}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted"],
      "properties": {
        "accepted": {"type": "boolean"},
        "json": {"type": "string", "minLength": 1},
        "error": {"$ref": "#/$defs/error"}
      },
      "if": {"properties": {"accepted": {"const": true}}},
      "then": {"required": ["json"], "not": {"required": ["error"]}},
      "else": {"required": ["error"], "not": {"required": ["json"]}}
    },
    "read": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "mode", "enumType", "input", "accepted"],
      "properties": {
        "operation": {"const": "read"},
        "mode": {"enum": ["bare", "concept", "nullable-bare"]},
        "enumType": {"$ref": "#/$defs/enumName"},
        "input": {"type": "string", "minLength": 1},
        "accepted": {"type": "boolean"},
        "numeric": {"$ref": "#/$defs/numeric"},
        "display": {"type": ["string", "null"]},
        "output": {"$ref": "#/$defs/output"},
        "error": {"$ref": "#/$defs/error"}
      },
      "if": {"properties": {"accepted": {"const": true}}},
      "then": {"required": ["numeric", "output"], "not": {"required": ["error"]}},
      "else": {"required": ["error"], "not": {"anyOf": [{"required": ["numeric"]}, {"required": ["output"]}, {"required": ["display"]}]}}
    },
    "write": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "mode", "enumType", "numeric", "output"],
      "properties": {
        "operation": {"const": "write"},
        "mode": {"enum": ["bare", "concept"]},
        "enumType": {"$ref": "#/$defs/enumName"},
        "numeric": {"$ref": "#/$defs/numeric"},
        "output": {"$ref": "#/$defs/output"}
      }
    },
    "direct": {
      "description": "Direct converter diagnostics for Plain only, not serializer wire outcomes.",
      "type": "object", "additionalProperties": false,
      "required": ["operation", "mode", "input", "accepted"],
      "properties": {
        "operation": {"const": "direct-read"},
        "mode": {"enum": ["bare", "concept"]},
        "input": {"type": "string", "minLength": 1},
        "accepted": {"type": "boolean"},
        "display": {"type": ["string", "null"]},
        "error": {"$ref": "#/$defs/error"}
      },
      "if": {"properties": {"accepted": {"const": true}}},
      "then": {"required": ["display"], "not": {"required": ["error"]}},
      "else": {"required": ["error"], "not": {"required": ["display"]}}
    }
  }
}
